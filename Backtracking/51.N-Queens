/*The n-queens puzzle is the problem of placing n queens on an n x n chessboard such that no two queens attack each other.

Given an integer n, return all distinct solutions to the n-queens puzzle. You may return the answer in any order.

Each solution contains a distinct board configuration of the n-queens' placement, where 'Q' and '.' both indicate a queen and an empty space, respectively.
Input: n = 4
Output: [[".Q..","...Q","Q...","..Q."],["..Q.","Q...","...Q",".Q.."]]
Explanation: There exist two distinct solutions to the 4-queens puzzle as shown above
Example 2:

Input: n = 1
Output: [["Q"]]

*/

class Solution {
    public List<List<String>> solveNQueens(int n) {
        char[][] board= new char[n][n];
        for(int i=0;i<n;i++){
            for(int j=0;j<n;j++){
                board[i][j]='.';
            }
        }
        List<List<String>> res=new ArrayList<>();
        queens(0,board,res);
        return res;
    }
    static void construct(char[][] board,List<List<String>> res){
        String row="";
        List<String> eachRow=new ArrayList<>();
        for(int i=0;i<board.length;i++){
            row="";
            for(int j=0;j<board[0].length;j++){
                if(board[i][j]=='Q')
                   row+="Q";
                else
                   row+=".";
            }
            eachRow.add(row);
        }
        res.add(eachRow);
    }
    static boolean isSafe(int row,int col,char[][] board){
        int duprow=row;
        int dupcol=col;
        while(row>=0 && col>=0){
            if(board[row][col]=='Q')
               return false;
            row--;
            col--;
        }
        row=duprow;
        col=dupcol;
        while(col>=0){
            if(board[row][col]=='Q')
               return false;
            col--;
        }
        row=duprow;
        col=dupcol;
        while(row<board.length && col>=0){
            if(board[row][col]=='Q')
               return false;
            row++;
            col--;
        }
        return true;
    }
    static void queens(int col,char[][] board,List<List<String>> res){
        if(col==board.length){
            construct(board,res);
            return;
        }
        for(int row=0;row<board.length;row++){
            if(isSafe(row,col,board)){
                board[row][col]='Q';
                queens(col+1,board,res);
                board[row][col]='.';
            }
        }
    }
}