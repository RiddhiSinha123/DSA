/*Given two strings word1 and word2, return the minimum number of operations required to convert word1 to word2.

You have the following three operations permitted on a word:

Insert a character
Delete a character
Replace a character
 

Example 1:

Input: word1 = "horse", word2 = "ros"
Output: 3
Explanation: 
horse -> rorse (replace 'h' with 'r')
rorse -> rose (remove 'r')
rose -> ros (remove 'e')
Example 2:

Input: word1 = "intention", word2 = "execution"
Output: 5
Explanation: 
intention -> inention (remove 't')
inention -> enention (replace 'i' with 'e')
enention -> exention (replace 'n' with 'x')
exention -> exection (replace 'n' with 'c')
exection -> execution (insert 'u')
*/
class Solution {
    public int minDistance(String word1, String word2) {
        int n=word1.length();
        int m=word2.length();
        int dp[][]=new int[n][m];
        for(int row[]:dp){
            Arrays.fill(row,-1);
        }
        return editDistance(word1,word2,n-1,m-1,dp);
    }
    public int editDistance(String word1,String word2,int i,int j,int[][] dp){
    if(i<0)
       return j+1;
    if(j<0)
       return i+1;
    if(dp[i][j]!=-1){
        return dp[i][j];
     }
     if(word1.charAt(i)==word2.charAt(j)){
        return dp[i][j]=0+editDistance(word1,word2,i-1,j-1,dp);
     }
     return dp[i][j]=1+Math.min(editDistance(word1,word2,i,j-1,dp),Math.min(editDistance(word1,word2,i-1,j,dp),editDistance(word1,word2,i-1,j-1,dp)));
    }
}
